{
  "name": "exception-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-examples.mjs && tsc -b && vite build && node scripts/package-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "node scripts/sync-examples.mjs --check && tsx scripts/check-content.ts",
    "package:python": "node scripts/package-python.mjs",
    "test:extended": "node scripts/run-extended.mjs",
    "test:offline": "node scripts/run-offline-tests.mjs",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "release:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "description": "中文交互式 Python 异常处理课程，支持单文件离线学习",
  "engines": {
    "node": ">=22.12.0"
  }
}
